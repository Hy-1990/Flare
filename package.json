{
  "name": "flare-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, open-source short-film desk.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "start": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.js",
    "setup:browser": "playwright-core install chromium-headless-shell",
    "format": "prettier --write src server shared tests tools *.json *.js *.html *.md docs/*.md",
    "format:check": "prettier --check src server shared tests tools *.json *.js *.html *.md docs/*.md",
    "styles:sync": "node tools/sync-styles.js",
    "test:styles": "node tests/styles-e2e.js",
    "test:ui": "node tests/ui-e2e.js"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  }
}
